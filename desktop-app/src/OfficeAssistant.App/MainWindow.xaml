<Window x:Class="OfficeAssistant.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全能办公助手"
        Height="600" Width="900" MinHeight="560" MinWidth="800"
        WindowStartupLocation="CenterScreen"
        Closing="OnClosing"
        PreviewKeyDown="OnPreviewKeyDown">

    <!-- 外壳：文档 3.2 要求的深蓝→藏蓝垂直渐变背景 + 顶部 1/3 极淡星点光晕（≤8% 透明）。
         界面切换在代码中完成，窗口只负责背景与承载当前界面。 -->
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A1633" Offset="0" />
                <GradientStop Color="#122B57" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <!-- 背景装饰：极淡星点与光晕，不干扰阅读 -->
        <Canvas IsHitTestVisible="False" ClipToBounds="True">
            <Ellipse Canvas.Left="-80" Canvas.Top="-120" Width="420" Height="420" Opacity="0.08">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#3B82F6" Offset="0" />
                        <GradientStop Color="#003B82F6" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="560" Canvas.Top="-60" Width="300" Height="300" Opacity="0.06">
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#9BB6E5" Offset="0" />
                        <GradientStop Color="#009BB6E5" Offset="1" />
                    </RadialGradientBrush>
                </Ellipse.Fill>
            </Ellipse>
            <Ellipse Canvas.Left="120" Canvas.Top="40" Width="3" Height="3" Fill="#FFFFFF" Opacity="0.08" />
            <Ellipse Canvas.Left="300" Canvas.Top="22" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.08" />
            <Ellipse Canvas.Left="470" Canvas.Top="70" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.07" />
            <Ellipse Canvas.Left="700" Canvas.Top="30" Width="3" Height="3" Fill="#FFFFFF" Opacity="0.08" />
            <Ellipse Canvas.Left="820" Canvas.Top="96" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.06" />
            <Ellipse Canvas.Left="210" Canvas.Top="130" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.06" />
            <Ellipse Canvas.Left="640" Canvas.Top="150" Width="2" Height="2" Fill="#FFFFFF" Opacity="0.05" />
        </Canvas>

        <!-- 当前界面宿主：切换时 200ms 淡入淡出 -->
        <ContentControl x:Name="ScreenHost" />
    </Grid>
</Window>
