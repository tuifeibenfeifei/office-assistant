<Application x:Class="OfficeAssistant.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:OfficeAssistant.App.Infrastructure"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 新版设计系统（文档第三章规格）：色值、组件、动效、图标 -->
                <ResourceDictionary Source="Theme/DesignSystem.xaml" />
                <ResourceDictionary Source="Theme/Icons.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 转换器 -->
            <conv:BytesConverter x:Key="Bytes" />
            <conv:UnixTimeConverter x:Key="UnixTime" />
            <conv:DateTimeConverter x:Key="DateTimeText" />
            <conv:EnumTextConverter x:Key="EnumText" />
            <conv:RiskBrushConverter x:Key="RiskBrush" />
            <conv:StateBrushConverter x:Key="StateBrush" />
            <conv:InverseBoolConverter x:Key="Not" />
            <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
            <conv:ThumbnailConverter x:Key="Thumbnail" />
            <conv:PercentConverter x:Key="Percent" />

            <!-- 画布与磁盘页用转换器 -->
            <conv:InverseBoolToVisibilityConverter x:Key="NotVis" />
            <conv:ResourceBrushConverter x:Key="BarBrush" />
            <conv:PercentToWidthConverter x:Key="BarWidth" />
            <conv:ClampPercentConverter x:Key="Clamp" />

            <!-- 主题色 -->
            <Color x:Key="AccentColor">#1F6FEB</Color>
            <SolidColorBrush x:Key="Accent" Color="#1F6FEB" />
            <SolidColorBrush x:Key="AccentSoft" Color="#E8F0FE" />
            <SolidColorBrush x:Key="Danger" Color="#C42B1C" />
            <SolidColorBrush x:Key="DangerSoft" Color="#FDECEA" />
            <SolidColorBrush x:Key="Warn" Color="#B26B00" />
            <SolidColorBrush x:Key="WarnSoft" Color="#FFF4E5" />
            <SolidColorBrush x:Key="Ok" Color="#1B7F3B" />
            <SolidColorBrush x:Key="OkSoft" Color="#E8F5EC" />
            <SolidColorBrush x:Key="Border" Color="#D8DEE6" />
            <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceAlt" Color="#F6F8FA" />
            <SolidColorBrush x:Key="TextPrimary" Color="#1B1F24" />
            <SolidColorBrush x:Key="TextSecondary" Color="#5B6570" />

            <!-- 基础排版 -->
            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="Caption" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextSecondary}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SectionTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,6" />
            </Style>

            <Style x:Key="PageTitle" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="18" />
                <Setter Property="FontWeight" Value="Bold" />
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>

            <!-- 卡片 -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource Surface}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="6" />
                <Setter Property="Padding" Value="10" />
                <Setter Property="Margin" Value="0,0,0,8" />
            </Style>

            <!-- 按钮 -->
            <Style TargetType="Button">
                <Setter Property="Padding" Value="12,6" />
                <Setter Property="Margin" Value="0,0,6,0" />
                <Setter Property="MinWidth" Value="76" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Background" Value="{StaticResource SurfaceAlt}" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource AccentSoft}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Accent}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource Accent}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </Style>

            <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource DangerSoft}" />
                <Setter Property="Foreground" Value="{StaticResource Danger}" />
                <Setter Property="BorderBrush" Value="{StaticResource Danger}" />
            </Style>

            <!-- 输入控件 -->
            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="PasswordBox">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="6,4" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style TargetType="CheckBox">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,2,12,2" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style>

            <Style TargetType="RadioButton">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Margin" Value="0,2,12,2" />
            </Style>

            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,10" />
                <Setter Property="Padding" Value="8" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
            </Style>

            <!-- 列表与表格 -->
            <Style TargetType="DataGrid">
                <Setter Property="AutoGenerateColumns" Value="False" />
                <Setter Property="CanUserAddRows" Value="False" />
                <Setter Property="CanUserDeleteRows" Value="False" />
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="HeadersVisibility" Value="Column" />
                <Setter Property="GridLinesVisibility" Value="Horizontal" />
                <Setter Property="HorizontalGridLinesBrush" Value="#EEF1F4" />
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="RowHeight" Value="26" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="SelectionMode" Value="Single" />
                <Setter Property="AlternatingRowBackground" Value="#FAFBFC" />
            </Style>

            <Style TargetType="TreeView">
                <Setter Property="BorderBrush" Value="{StaticResource Border}" />
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style TargetType="TabItem">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI, Microsoft YaHei, Segoe UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="14,7" />
            </Style>

            <Style x:Key="Hint" TargetType="TextBlock" BasedOn="{StaticResource Caption}">
                <Setter Property="Margin" Value="0,4,0,8" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
