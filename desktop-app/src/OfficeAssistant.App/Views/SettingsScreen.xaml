<UserControl x:Class="OfficeAssistant.App.Views.SettingsScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600">

    <!-- 界面 5：设置
         规格：顶部居中"设置"22px 粗体；左侧 160px 导航（三项文字、15px、行高 48px、
               左对齐留 16px 内边距、选中亮绿、悬停浅蓝、切换 150ms 淡入）；
               右侧玻璃卡片内边距 24px，三条 56px 设置行，行间 1px 浅蓝半透明分隔线；
               行内只有：左侧 15px 条目名 + 右侧 44×24 拨动开关，无任何说明文字。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 居中标题 -->
        <Grid Grid.Row="0" Margin="32,24,32,0">
            <Button Style="{StaticResource Btn.IconGhost}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="OnBackClick" ToolTip="返回">
                <Path Data="{StaticResource Geo.Back}" Style="{StaticResource Icon.Base}" Width="20" Height="20" />
            </Button>
            <TextBlock Text="设置" Style="{StaticResource T.ScreenTitle}" />
        </Grid>

        <!-- 主体：左导航 + 右内容 -->
        <Grid Grid.Row="1" Margin="32,24,32,28">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="160" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 左侧导航 -->
            <StackPanel Grid.Column="0">
                <StackPanel.Resources>
                    <Style x:Key="NavItem" TargetType="RadioButton">
                        <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
                        <Setter Property="FontSize" Value="15" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                        <Setter Property="Height" Value="48" />
                        <Setter Property="Padding" Value="16,0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Left" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <!-- 悬停变浅蓝 -->
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Blue}" />
                                        </Trigger>
                                        <!-- 选中亮绿 -->
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Green}" />
                                            <Setter Property="FontWeight" Value="Bold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </StackPanel.Resources>

                <RadioButton x:Name="NavGeneral" Content="常规" GroupName="SettingsNav"
                             Style="{StaticResource NavItem}" IsChecked="True" Checked="OnNavChanged" Tag="general" />
                <RadioButton x:Name="NavHelp" Content="使用说明" GroupName="SettingsNav"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" Tag="help" />
                <RadioButton x:Name="NavAbout" Content="关于" GroupName="SettingsNav"
                             Style="{StaticResource NavItem}" Checked="OnNavChanged" Tag="about" />
            </StackPanel>

            <!-- 右侧内容：三页共用一块区域，切换时 150ms 淡入 -->
            <Grid x:Name="ContentHost" Grid.Column="1" Margin="24,0,0,0">

                <!-- 常规 -->
                <Border x:Name="PageGeneral" Style="{StaticResource Card.Glass}" VerticalAlignment="Top"
                        Padding="24,8,24,8" Opacity="0">
                    <StackPanel>
                        <Grid Height="56">
                            <TextBlock Text="开机启动" FontFamily="{StaticResource Font.UI}" FontSize="15"
                                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding AutoStart}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource Brush.Divider}" />
                        <Grid Height="56">
                            <TextBlock Text="自动清理内存" FontFamily="{StaticResource Font.UI}" FontSize="15"
                                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding Enabled}" />
                        </Grid>
                        <Border Height="1" Background="{StaticResource Brush.Divider}" />
                        <Grid Height="56">
                            <TextBlock Text="常驻托盘" FontFamily="{StaticResource Font.UI}" FontSize="15"
                                       Foreground="{StaticResource Brush.Text}" VerticalAlignment="Center" />
                            <CheckBox Style="{StaticResource Toggle.Switch}" HorizontalAlignment="Right"
                                      VerticalAlignment="Center" IsChecked="{Binding MinimizeToTray}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 使用说明：全页可滚动图文，每一条 = 16px 白色粗体小标题 + 14px 正文 + 示意图 -->
                <ScrollViewer x:Name="PageHelp" VerticalScrollBarVisibility="Auto" Opacity="0"
                              Visibility="Collapsed" Padding="0,0,8,0">
                    <StackPanel x:Name="HelpList" />
                </ScrollViewer>

                <!-- 关于 -->
                <StackPanel x:Name="PageAbout" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0">
                    <TextBlock x:Name="AboutName" Text="全能办公助手" Style="{StaticResource T.Title}"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="版本 1.0" Style="{StaticResource T.Soft}" HorizontalAlignment="Center"
                               Margin="0,10,0,0" />
                    <TextBlock Text="本地办公辅助工具，数据不上传" Style="{StaticResource T.Caption}"
                               HorizontalAlignment="Center" Margin="0,8,0,0" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
