<UserControl x:Class="OfficeAssistant.App.Views.DiskTreeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:OfficeAssistant.App.ViewModels"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="720">

    <!-- 磁盘管理：目录树 + 一键清理 / 深度清理。
         设计取舍（按实际使用反馈调整）：只保留"看清单 + 把能清的清掉"这条主线。
         早期的无限画布与拖拽搬运已整体移除——拖拽卡顿、学习成本高，
         而真正被需要的是"一键清理能清理的东西"。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#0A1633" Offset="0" />
                <GradientStop Color="#122B57" Offset="1" />
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.Resources>
            <Style x:Key="Row.Text" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.UI}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="Row.Sub" TargetType="TextBlock">
                <Setter Property="FontFamily" Value="{StaticResource Font.Mono}" />
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextSoft}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
        </Grid.Resources>

        <!-- 顶部工具栏 -->
        <Grid Grid.Row="0" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource Btn.IconGhost}" Click="OnBackClick" ToolTip="返回">
                    <Path Data="{StaticResource Geo.Back}" Style="{StaticResource Icon.Base}" Width="20" Height="20" />
                </Button>
                <TextBlock Text="磁盘清理" Style="{StaticResource T.Title}" VerticalAlignment="Center"
                           Margin="8,0,0,0" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
                <Button Content="扫描" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,0"
                        Command="{Binding ScanCommand}" ToolTip="只读扫描建立索引，不会修改任何文件" />
                <Button Content="一键清理" Style="{StaticResource Btn.Primary}" Margin="0,0,8,0"
                        Click="OnCleanupClick" ToolTip="按规则匹配可安全删除的内容，先预览再删除"
                        IsEnabled="{Binding IsCleanupBusy, Converter={StaticResource Not}}" />
                <Button Content="深度清理" Style="{StaticResource Btn.Secondary}"
                        Click="OnTrustedCleanupClick" ToolTip="只清理系统公认的临时目录，删掉的内容程序会自动重建"
                        IsEnabled="{Binding IsTrustedBusy, Converter={StaticResource Not}}" />
            </StackPanel>
        </Grid>

        <!-- 主体：目录树 + 操作栏 -->
        <Grid Grid.Row="1" Margin="20,14,20,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource Card.Glass}" Padding="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--
                        虚拟化是这里的生死线：TreeView 默认不虚拟化，
                        索引里有近两万个节点，一旦展开任何交互都会遍历全部行，表现就是"点哪都卡死"。
                    -->
                    <TreeView x:Name="FolderTree" ItemsSource="{Binding Roots}" BorderThickness="0"
                              Background="Transparent" Margin="6" Padding="4"
                              VirtualizingStackPanel.IsVirtualizing="True"
                              VirtualizingStackPanel.VirtualizationMode="Recycling"
                              ScrollViewer.IsDeferredScrollingEnabled="True"
                              ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                              SelectedItemChanged="OnTreeSelectionChanged">
                        <TreeView.Resources>
                            <HierarchicalDataTemplate DataType="{x:Type vm:FileNodeViewModel}"
                                                      ItemsSource="{Binding Children}">
                                <Grid Height="26" Margin="0,1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,6,0"
                                              Visibility="{Binding IsPlaceholder, Converter={StaticResource NotVis}}"
                                              Click="OnCheckClick" />

                                    <Path Grid.Column="1" Data="{StaticResource Geo.Folder}"
                                          Style="{StaticResource Icon.Base}" Width="15" Height="15"
                                          Stroke="{StaticResource Brush.Green}" Margin="0,0,6,0"
                                          Visibility="{Binding IsFolder, Converter={StaticResource BoolToVis}}" />

                                    <TextBlock Grid.Column="2" Text="{Binding Name}" Style="{StaticResource Row.Text}"
                                               ToolTip="{Binding Path}" />

                                    <TextBlock Grid.Column="3" Text="{Binding SizeText}" Style="{StaticResource Row.Sub}"
                                               Margin="10,0,10,0" />

                                    <TextBlock Grid.Column="4" Text="{Binding TypeText}" Style="{StaticResource Row.Sub}"
                                               Opacity="0.75" MinWidth="72" TextAlignment="Right" />
                                </Grid>
                            </HierarchicalDataTemplate>
                        </TreeView.Resources>
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.Text}" />
                                <Setter Property="Padding" Value="2" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TreeViewItem">
                                            <StackPanel>
                                                <Border x:Name="Row" Background="Transparent" Padding="0,1">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="16" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <ToggleButton x:Name="Expander" Grid.Column="0"
                                                                      IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                                                      ClickMode="Press" Cursor="Hand">
                                                            <ToggleButton.Template>
                                                                <ControlTemplate TargetType="ToggleButton">
                                                                    <Path x:Name="Arrow" Data="M 0,0 L 5,5 L 0,10"
                                                                          Stroke="{StaticResource Brush.TextSoft}"
                                                                          StrokeThickness="1.6" Fill="{x:Null}"
                                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                                          VerticalAlignment="Center" HorizontalAlignment="Center" />
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsChecked" Value="True">
                                                                            <Setter TargetName="Arrow" Property="Data" Value="M 0,0 L 5,5 L 10,0" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </ToggleButton.Template>
                                                        </ToggleButton>
                                                        <ContentPresenter Grid.Column="1" ContentSource="Header" />
                                                    </Grid>
                                                </Border>
                                                <ItemsPresenter x:Name="Items" Margin="16,0,0,0" />
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsExpanded" Value="False">
                                                    <Setter TargetName="Items" Property="Visibility" Value="Collapsed" />
                                                </Trigger>
                                                <Trigger Property="HasItems" Value="False">
                                                    <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
                                                </Trigger>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Row" Property="Background" Value="#14FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TreeView.ItemContainerStyle>
                    </TreeView>

                    <ProgressBar Grid.Row="1" Height="4" Margin="6,6,6,6" Minimum="0" Maximum="100"
                                 BorderThickness="0" Background="#22FFFFFF"
                                 Foreground="{StaticResource Brush.Green}"
                                 Value="{Binding ProgressPercent, Mode=OneWay, Converter={StaticResource Clamp}}"
                                 Visibility="{Binding IsScanning, Converter={StaticResource BoolToVis}}" />
                </Grid>
            </Border>

            <!-- 右侧操作栏 -->
            <Border Grid.Column="1" Style="{StaticResource Card.Glass}" Padding="16" Margin="14,0,0,0">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="清理" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="两个按钮都会先给出清单，确认后才删除；删除统一进回收站，可恢复。"
                                   Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="一键清理（按规则匹配）" Style="{StaticResource Btn.Primary}"
                                Margin="0,12,0,0" HorizontalAlignment="Stretch" Click="OnCleanupClick"
                                IsEnabled="{Binding IsCleanupBusy, Converter={StaticResource Not}}" />
                        <Button Content="深度清理（只清临时文件）" Style="{StaticResource Btn.Secondary}"
                                Margin="0,8,0,0" HorizontalAlignment="Stretch" Click="OnTrustedCleanupClick"
                                IsEnabled="{Binding IsTrustedBusy, Converter={StaticResource Not}}" />

                        <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,14" />

                        <TextBlock Text="已勾选的条目" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="{Binding BatchSummary}" Style="{StaticResource T.Soft}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="删除已勾选" Style="{StaticResource Btn.Danger}" Margin="0,12,0,0"
                                HorizontalAlignment="Stretch" Click="OnDeleteCheckedClick" />
                        <Button Content="全选当前已展开" Style="{StaticResource Btn.Secondary}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Click="OnSelectAllClick" />
                        <Button Content="清空勾选" Style="{StaticResource Btn.Secondary}" Margin="0,8,0,0"
                                HorizontalAlignment="Stretch" Click="OnClearCheckedClick" />

                        <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,14" />

                        <TextBlock Text="待判断文件" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="扫描时无法识别内容的文件集中在这里，由你决定保留还是删除。"
                                   Style="{StaticResource T.Caption}" TextWrapping="Wrap" Margin="0,6,0,0" />
                        <Button Content="打开待判断列表" Style="{StaticResource Btn.Secondary}" Margin="0,10,0,0"
                                HorizontalAlignment="Stretch" Click="OnUnknownClick" />

                        <Border Height="1" Background="{StaticResource Brush.Divider}" Margin="0,14" />

                        <TextBlock Text="状态" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Text}" />
                        <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Caption}"
                                   TextWrapping="Wrap" Margin="0,6,0,0" />
                        <TextBlock Text="{Binding IndexSummary}" Style="{StaticResource T.Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                        <TextBlock Text="{Binding SelectedDetailText}" Style="{StaticResource T.Caption}"
                                   TextWrapping="Wrap" Margin="0,8,0,0" />
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- ============ 预览与抽屉（覆盖层）============ -->

        <!-- 一键清理预览 -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000"
                Visibility="{Binding IsCleanupPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card.Glass}" Width="460" MaxHeight="560" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="一键清理预览" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding CleanupPreviewSummary}"
                               Style="{StaticResource T.Soft}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Top" Text="删除统一移入回收站，可恢复。" Style="{StaticResource T.Caption}"
                               Margin="0,4,0,10" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="取消" Style="{StaticResource Btn.Secondary}" Click="OnCancelCleanupClick" />
                        <Button Content="确认清理" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0"
                                Click="OnConfirmCleanupClick" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <ItemsControl ItemsSource="{Binding CleanupGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <TextBlock Text="{Binding Category}" Style="{StaticResource Row.Text}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource Row.Sub}"
                                                       Margin="0,0,12,0" />
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Row.Sub}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- 深度清理预览 -->
        <Border Grid.Row="0" Grid.RowSpan="2" Background="#99000000"
                Visibility="{Binding IsTrustedPreviewOpen, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource Card.Glass}" Width="560" MaxHeight="560" Padding="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="深度清理预览" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock DockPanel.Dock="Top" Text="{Binding TrustedPreviewSummary}"
                               Style="{StaticResource T.Soft}" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <TextBlock DockPanel.Dock="Top" Text="只覆盖系统公认的临时目录；删除仍走回收站，可恢复。"
                               Style="{StaticResource T.Caption}" Margin="0,4,0,10" />
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                                Margin="0,14,0,0">
                        <Button Content="取消" Style="{StaticResource Btn.Secondary}" Click="OnCancelTrustedClick" />
                        <Button Content="全部清理" Style="{StaticResource Btn.Primary}" Margin="8,0,0,0"
                                Click="OnConfirmTrustedClick" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="360">
                        <ItemsControl ItemsSource="{Binding TrustedRows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                            <TextBlock Text="{Binding Name}" Style="{StaticResource Row.Text}" />
                                            <TextBlock Text="{Binding WhySafe}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{StaticResource Brush.TextSoft}" Margin="0,2,0,0" />
                                            <TextBlock Text="{Binding PathText}" Style="{StaticResource T.Caption}"
                                                       TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SizeText}" Style="{StaticResource Row.Sub}"
                                                       TextAlignment="Right" />
                                            <TextBlock Text="{Binding CountText}" Style="{StaticResource T.Caption}"
                                                       TextAlignment="Right" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Border>

        <!-- 待判断文件抽屉 -->
        <Border Grid.Row="0" Grid.RowSpan="2" HorizontalAlignment="Right" Width="520" Background="#F20A1633"
                BorderBrush="{StaticResource Brush.CardBorder}" BorderThickness="1,0,0,0"
                Visibility="{Binding IsUnknownDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Text="待判断文件" FontSize="16" FontWeight="Bold"
                           Foreground="{StaticResource Brush.Text}" />
                <ScrollViewer Grid.Row="1" Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding UnknownRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox Grid.Column="0" IsChecked="{Binding Selected, Mode=TwoWay}"
                                              VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" Style="{StaticResource Row.Text}" />
                                        <TextBlock Text="{Binding Path}" Style="{StaticResource T.Caption}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                               Style="{StaticResource Row.Sub}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <StackPanel Grid.Row="2" Margin="0,12,0,0">
                    <TextBlock Text="这些文件无法自动识别，请自行判断" Style="{StaticResource T.Caption}" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="保留" Style="{StaticResource Btn.Secondary}" Click="OnUnknownKeepClick" />
                        <Button Content="删除" Style="{StaticResource Btn.Danger}" Margin="8,0,0,0"
                                Click="OnUnknownDeleteClick" />
                        <Button Content="关闭" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0"
                                Click="OnCloseDrawerClick" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
