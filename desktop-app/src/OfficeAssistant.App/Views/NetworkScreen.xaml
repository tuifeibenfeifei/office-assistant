<UserControl x:Class="OfficeAssistant.App.Views.NetworkScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600">

    <!-- 界面 2：网络加速
         规格：左上 20px 返回箭头（悬停变亮绿）；顶部居中"网络加速"22px 粗体；
               正中 120px 正圆按钮（亮绿底、48px 白色实心闪电、常态辉光 0.5）；
               按钮正下方两条 56px 状态条目（10px 状态圆点 + 14px 平台名 + 右对齐浅蓝等宽数字）。
               全界面无菜单、无说明文案、无多余控件。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 居中标题 -->
        <Grid Grid.Row="0" Margin="32,24,32,0">
            <Button x:Name="BackButton" Style="{StaticResource Btn.IconGhost}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="OnBackClick" ToolTip="返回">
                <Path x:Name="BackIcon" Data="{StaticResource Geo.Back}" Style="{StaticResource Icon.Base}"
                      Width="20" Height="20" />
            </Button>
            <TextBlock Text="网络加速" Style="{StaticResource T.ScreenTitle}" />
        </Grid>

        <!-- 中部：大圆按钮 + 状态条目 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,48">

            <Button x:Name="AccelerateButton" Width="120" Height="120"
                    HorizontalAlignment="Center" Cursor="Hand"
                    Background="Transparent" BorderThickness="0"
                    Command="{Binding ProbeCommand}" Click="OnAccelerateClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <ScaleTransform x:Name="Sc" ScaleX="1" ScaleY="1" />
                            </Grid.RenderTransform>
                            <!-- 常态辉光 0 0 24px rgba(34,229,132,0.5)：单独一层负责辉光强弱 -->
                            <Ellipse x:Name="GlowLayer" Fill="#22E584" Opacity="0.55">
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="24" ShadowDepth="0" Color="#22E584" Opacity="1" />
                                </Ellipse.Effect>
                            </Ellipse>
                            <!-- 中心 48px 白色实心闪电 -->
                            <Path Data="{StaticResource Geo.BoltSolid}" Style="{StaticResource Icon.Solid}"
                                  Fill="#FFFFFF" Width="48" Height="48"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <!-- 悬停：辉光增强并略微放大到 1.02 -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0.8" Duration="{StaticResource Duration.Quick}" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1.02" Duration="{StaticResource Duration.Quick}" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1.02" Duration="{StaticResource Duration.Quick}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="GlowLayer" Storyboard.TargetProperty="Opacity"
                                                             To="0.55" Duration="{StaticResource Duration.Quick}" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="{StaticResource Duration.Quick}" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="{StaticResource Duration.Quick}" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <!-- 按下：缩小到 0.94 -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="0.94" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="0.94" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleX"
                                                             To="1" Duration="0:0:0.1" />
                                            <DoubleAnimation Storyboard.TargetName="Sc" Storyboard.TargetProperty="ScaleY"
                                                             To="1" Duration="0:0:0.1" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="GlowLayer" Property="Opacity" Value="0.2" />
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <!-- 状态条目：两行，行高 56px，行间无分隔线 -->
            <ItemsControl ItemsSource="{Binding Probes}" HorizontalAlignment="Center" Margin="0,28,0,0"
                          Width="360">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Height="56">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!-- 10px 状态圆点：可连通=亮绿带辉光 / 等待=灰蓝 / 失败=红 -->
                            <Ellipse Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                     Fill="{Binding IsReachable, Converter={StaticResource StateBrush}}">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsReachable}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect BlurRadius="10" ShadowDepth="0"
                                                                          Color="#22E584" Opacity="0.6" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Grid.Column="1" Text="{Binding Group}" Style="{StaticResource T.Body}"
                                       VerticalAlignment="Center" Margin="12,0,0,0" />
                            <!-- 右侧自动右对齐的浅蓝等宽状态文字 -->
                            <TextBlock Grid.Column="2" Text="{Binding StatusCellText}" Style="{StaticResource T.Num}"
                                       VerticalAlignment="Center" HorizontalAlignment="Right"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 失败诊断：说清卡在哪一段、该怎么办。
                 之前这里只显示"可达/不可达"，用户点完按钮看不到原因，观感就是"加速不成功"。 -->
            <ItemsControl ItemsSource="{Binding FailedProbes}" HorizontalAlignment="Center" Width="420"
                          Margin="0,16,0,0">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{Binding Group}" FontSize="13" FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text}" />
                            <TextBlock Text="{Binding FailureText}" FontSize="11" TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextSoft}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 结果与结论 -->
            <TextBlock Text="{Binding StatusText}" Style="{StaticResource T.Caption}" Width="420"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,14,0,0" />
            <TextBlock Text="{Binding GitStatusText}" Style="{StaticResource T.Caption}" Width="420"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
