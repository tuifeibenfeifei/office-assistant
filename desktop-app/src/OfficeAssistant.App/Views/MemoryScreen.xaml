<UserControl x:Class="OfficeAssistant.App.Views.MemoryScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="600">

    <!-- 界面 4：内存清理
         规格：左上返回箭头；顶部居中"内存清理"22px 粗体；
               右上角 8px 亮绿发光圆点 + 12px 灰蓝"自动清理已开启"（关闭时文案与颜色变化）；
               正中 200px 白色细线圆环（线宽 2px），环心 40px 亮绿粗体累计释放 MB 数，
               下方 13px 浅蓝"MB 已释放"；圆环正下方一个"立即清理"亮绿按钮。
               全界面只有标题、圆环与数字、一个按钮、一行状态。 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 顶部：返回 + 居中标题 + 右上自动清理状态 -->
        <Grid Grid.Row="0" Margin="32,24,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Grid.Column="0" Style="{StaticResource Btn.IconGhost}"
                    HorizontalAlignment="Left" VerticalAlignment="Center"
                    Click="OnBackClick" ToolTip="返回">
                <Path Data="{StaticResource Geo.Back}" Style="{StaticResource Icon.Base}" Width="20" Height="20" />
            </Button>

            <TextBlock Grid.Column="1" Text="内存清理" Style="{StaticResource T.ScreenTitle}" />

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="AutoDot" Width="8" Height="8" VerticalAlignment="Center"
                         Fill="{StaticResource Brush.Green}">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="10" ShadowDepth="0" Color="#22E584" Opacity="0.8" />
                    </Ellipse.Effect>
                </Ellipse>
                <TextBlock x:Name="AutoText" Text="自动清理已开启" Style="{StaticResource T.Caption}"
                           Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </Grid>

        <!-- 中部：圆环 + 数字 + 按钮 -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,40">

            <!-- 结果圆环：外径 200px、线宽 2px（椭圆几何参数固定，不随布局缩放，保证精确尺寸） -->
            <Grid x:Name="RingRoot" Width="200" Height="200" HorizontalAlignment="Center">
                <!-- 静态细线圆环（白） -->
                <Path Stroke="#E6FFFFFF" StrokeThickness="2" Fill="{x:Null}"
                      Data="M 100,0 A 100,100 0 1 1 99.9,0 Z" />
                <!-- 执行中旋转的绿色流光弧 -->
                <Path x:Name="RingFlow" Stroke="{StaticResource Brush.Green}" StrokeThickness="2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" Fill="{x:Null}"
                      Opacity="0" RenderTransformOrigin="0.5,0.5"
                      Data="M 100,0 A 100,100 0 0 1 200,100">
                    <Path.RenderTransform>
                        <RotateTransform x:Name="RingSpin" Angle="0" />
                    </Path.RenderTransform>
                    <Path.Effect>
                        <DropShadowEffect BlurRadius="12" ShadowDepth="0" Color="#22E584" Opacity="0.8" />
                    </Path.Effect>
                </Path>

                <!-- 环心：40px 亮绿粗体数字 + 13px 浅蓝单位 -->
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="ReleasedValue" Text="{Binding TotalReleasedMb}"
                               FontFamily="{StaticResource Font.UI}" FontSize="40" FontWeight="Bold"
                               Foreground="{StaticResource Brush.Green}" HorizontalAlignment="Center" />
                    <TextBlock Text="MB 已释放" FontFamily="{StaticResource Font.UI}" FontSize="13"
                               Foreground="{StaticResource Brush.TextSoft}" HorizontalAlignment="Center"
                               Margin="0,2,0,0" />
                </StackPanel>
            </Grid>

            <!-- 清理按钮：160×40、12px 圆角、常态辉光；执行中灰蓝禁用并显示"清理中…" -->
            <Button x:Name="CleanButton" Content="立即清理" Style="{StaticResource Btn.Primary}"
                    Width="160" Height="40" Margin="0,24,0,0"
                    Command="{Binding RunNowCommand}" Click="OnCleanClick" />
        </StackPanel>
    </Grid>
</UserControl>
