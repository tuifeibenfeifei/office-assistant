{
  "name": "dsh-office-assistant",
  "version": "1.0.0",
  "type": "module",
  "description": "办公助手（dsh 插件）：给 Agent 四个办公工具——文本与 JSON 处理、只读磁盘占用扫描、系统临时目录清理（走回收站可恢复）、内存查看与工作集整理；侧边栏常驻内存状态。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis-plugin",
    "office",
    "cleanup",
    "disk",
    "memory"
  ],
  "license": "MIT",
  "icon": "./icon.svg",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "meta": {
    "title": "办公助手 / Office Assistant",
    "description": "给 Agent 四个办公工具：文本与 JSON 处理、只读磁盘占用扫描、系统临时目录清理（走回收站可恢复）、内存查看与工作集整理。侧边栏常驻内存占用。"
  },
  "scripts": {
    "test": "node tests/run.js"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "tests",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  }
}
